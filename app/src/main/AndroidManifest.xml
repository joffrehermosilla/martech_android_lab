<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================= -->
    <!-- INTERNET & NETWORK -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ========================= -->
    <!-- PUSH NOTIFICATIONS -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ========================= -->
    <!-- ADOBE PLACES / LOCATION -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <application
        android:name=".MessagingApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AJOTemplateApp">

        <!-- ACTIVITIES -->
        <activity
            android:name=".ui.places.PlacesActivity"
            android:exported="false"
            android:theme="@style/Theme.AJOTemplateApp"/>
        <activity
            android:name=".ui.logs.LogsActivity"
            android:exported="false"
            android:theme="@style/Theme.AJOTemplateApp"/>
        <activity
            android:name=".ui.identity.IdentityActivity"
            android:exported="false"
            android:theme="@style/Theme.AJOTemplateApp"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AJOTemplateApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <receiver
            android:name=".location.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- FIREBASE MESSAGING SERVICE -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

    </application>

</manifest>
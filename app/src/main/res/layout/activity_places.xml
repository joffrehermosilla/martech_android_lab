<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Adobe Places &amp; Geofencing"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#0057FF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Simulador Developer de Ubicación para Triggers AJO / CDP"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Developer Location Preset Buttons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:text="📍 Ubicaciones Demo Enterprise"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSimSanIsidro"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:text="BCP San Isidro"
                            android:textColor="#0057FF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnSimMiraflores"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:text="Miraflores / Larcomar"
                            android:textColor="#0057FF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnSimJockey"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:text="Jockey Plaza"
                            android:textColor="#0057FF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnSimAeropuerto"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:text="Aeropuerto"
                            android:textColor="#0057FF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnSimPlazaNorte"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:text="Plaza Norte"
                            android:textColor="#0057FF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Coordinates Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:text="Coordenadas Personalizadas"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editLatitude"
                        android:hint="Latitud"
                        android:text="-12.09722"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/editLongitude"
                        android:hint="Longitud"
                        android:text="-77.03698"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSearchPlaces"
                    android:text="Consultar Adobe Places"
                    android:backgroundTint="#0057FF"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Results & Status Card -->
        <TextView
            android:id="@+id/txtStatus"
            android:text="Esperando consulta..."
            android:textStyle="bold"
            android:textColor="#0057FF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPOIs"
            android:layout_width="match_parent"
            android:layout_height="350dp"/>

    </LinearLayout>
</ScrollView>
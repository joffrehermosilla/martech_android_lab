<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Titulo -->
    <TextView
        android:id="@+id/txtDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adobe Mobile SDK"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingTop="20dp"/>

    <!-- Grid de Mini Apps -->
    <GridLayout
        android:id="@+id/gridDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:padding="8dp">

        <include layout="@layout/item_mini_identity"/>

        <include layout="@layout/item_mini_places"/>

        <include layout="@layout/item_mini_push"/>

        <include layout="@layout/item_mini_inapp"/>

        <include layout="@layout/item_mini_journey"/>

        <include layout="@layout/item_mini_logs"/>

    </GridLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer ID (Identity Stitching CDP)"
            android:textStyle="bold"
            android:textColor="#0057FF"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acepta cualquier formato: DNI, UUID, SHA256, HASH, CRMID, Email"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editCustomerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese CustomerID (ej: HASH / UUID / DNI)"
            android:textSize="14sp"
            android:inputType="text"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnUpdateCustomerId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Asociar CustomerID"
                android:backgroundTint="#0057FF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnResetIdentity"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Reset Identity"
                android:textColor="#FF3B30"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>